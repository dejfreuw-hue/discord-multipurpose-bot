{
  "name": "reuw-bot",
  "version": "1.0.0",
  "description": "All-in-one Discord bot by ReuwTheDev",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "commands:deploy": "node dist/scripts/commands.js deploy",
    "commands:clear": "node dist/scripts/commands.js clear",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.5",
    "lavalink-client": "^2.11.0",
    "mongoose": "^9.10.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^20.19.0",
    "tsx": "^4.23.0",
    "vitest": "^4.1.11",
    "eslint": "^10.11.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.71.0"
  }
}
